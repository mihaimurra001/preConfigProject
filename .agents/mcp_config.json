{
  "mcpServers": {
    "graphify": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "graphifyy",
        "--with",
        "mcp",
        "-m",
        "graphify.serve",
        "${workspace.path}/graphify-out/graph.json"
      ]
    },
    "headroom": {
      "command": "uvx",
      "args": [
        "headroom-ai[all]",
        "mcp"
      ]
    }
  }
}